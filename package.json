{
  "name": "turbo-modal-dialog",
  "version": "0.2.1",
  "description": "Present Turbo Drive navigations as modals — bringing a Hotwire Native–compatible approach to the web.",
  "type": "module",
  "main": "dist/turbo-modal-dialog.es2017-umd.js",
  "module": "dist/turbo-modal-dialog.es2017-esm.js",
  "exports": {
    ".": {
      "import": "./dist/turbo-modal-dialog.es2017-esm.js",
      "require": "./dist/turbo-modal-dialog.es2017-umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "turbo",
    "hotwire",
    "hotwire-native",
    "modal",
    "dialog",
    "path-configuration"
  ],
  "author": "Toru KAWAMURA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkawa/turbo-modal-dialog.git"
  },
  "homepage": "https://github.com/tkawa/turbo-modal-dialog#readme",
  "bugs": {
    "url": "https://github.com/tkawa/turbo-modal-dialog/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@hotwired/turbo": "^8.0.0"
  },
  "scripts": {
    "build": "rollup -c && cp src/style.css dist/style.css",
    "watch": "rollup -wc",
    "start": "node src/tests/server.mjs",
    "pretest": "npm run build",
    "test": "playwright test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@hotwired/turbo": "^8.0.0",
    "@playwright/test": "^1.51.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "express": "^5.0.0",
    "rollup": "^4.60.2"
  }
}
